{
  "name": "hwacance-widget",
  "version": "1.3.1",
  "description": "화캉스 데스크톱 위젯 - 화장쉼 스톱워치",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:mac": "electron-builder --mac"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hwacance.widget",
    "productName": "화캉스 위젯",
    "files": [
      "main.js",
      "preload.js",
      "widget.html",
      "settings.html",
      "telemetry.js",
      "icon.png",
      "tissue-icon.png",
      "fonts/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png",
      "artifactName": "hwacance-widget-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "hwacance-widget-${version}-mac.${ext}",
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
