{
  "name": "gongcance-widget",
  "version": "1.0.15",
  "description": "공캉스 데스크톱 위젯 - 스터디 브레이크 스톱워치",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:mac": "electron-builder --mac"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hwacance.gongcance",
    "productName": "공캉스 위젯",
    "files": [
      "main.js",
      "preload.js",
      "widget.html",
      "settings.html",
      "icon.png",
      "telemetry.js"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
